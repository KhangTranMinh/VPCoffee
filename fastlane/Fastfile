default_platform(:android)

platform :android do
  desc "Check git status is clean"
  private_lane :check_git_clean do
    status = sh("git status --porcelain")
    unless status.strip.empty?
      UI.user_error!("Git working directory is not clean. Please commit or stash your changes first.")
    end
  end

  desc "Increment version code in build.gradle.kts"
  private_lane :increment_version_code do |options|
    project_root = File.expand_path("..", __dir__)
    file_path = File.join(project_root, options[:file])
    content = File.read(file_path)
    version_code = content.match(/versionCode = (\d+)/)[1].to_i
    new_version_code = version_code + 1
    content.gsub!(/versionCode = \d+/, "versionCode = #{new_version_code}")
    File.write(file_path, content)
    UI.success("Incremented versionCode to #{new_version_code} in #{file_path}")
    new_version_code
  end

  desc "Setup git authentication"
  private_lane :setup_git_auth do
    project_root = File.expand_path("..", __dir__)
    env_file = File.join(project_root, "credentials/.env")
    token = File.read(env_file).match(/GITHUB_TOKEN=(.+)/)[1].strip
    sh("git remote set-url origin https://#{token}@github.com/KhangTranMinh/VPCoffee.git")
  end

  desc "Restore git remote URL"
  private_lane :restore_git_remote do
    sh("git remote set-url origin https://github.com/KhangTranMinh/VPCoffee.git")
  end

  desc "Deploy VPCoffee to Firebase App Distribution"
  lane :deploy_vpcoffee do
    new_version = increment_version_code(file: "app/build.gradle.kts")
    gradle(task: "assembleDebug")
    firebase_app_distribution(
      app: "1:199219837870:android:c460f72d4feddf0c65e63f",
      groups: "internal",
      release_notes: "VPCoffee v1.0.#{new_version}",
      service_credentials_file: "credentials/service-account.json"
    )
    # Copy APK to GitHub Pages site (only keep latest)
    apk_file = "VPCoffee-v1.0.#{new_version}.apk"
    project_root = File.expand_path("..", __dir__)
    sh("mkdir -p #{project_root}/site")
    sh("rm -f #{project_root}/site/VPCoffee-*.apk")
    sh("cp #{project_root}/app/build/outputs/apk/debug/app-debug.apk #{project_root}/site/#{apk_file}")
    git_commit(
      path: ["app/build.gradle.kts", "site/"],
      message: "chore: release v1.0.#{new_version} [skip apk deploy]"
    )
  end

  desc "Deploy PushTest to Firebase App Distribution"
  lane :deploy_pushtest do
    new_version = increment_version_code(file: "pushtest/build.gradle.kts")
    gradle(task: ":pushtest:assembleDebug")
    firebase_app_distribution(
      app: "1:199219837870:android:a3d923ec6b48b98065e63f",
      groups: "internal",
      release_notes: "PushTest v1.0.#{new_version}",
      service_credentials_file: "credentials/service-account.json"
    )
    # Copy APK to GitHub Pages site (only keep latest)
    apk_file = "PushTest-v1.0.#{new_version}.apk"
    project_root = File.expand_path("..", __dir__)
    sh("mkdir -p #{project_root}/site")
    sh("rm -f #{project_root}/site/PushTest-*.apk")
    sh("cp #{project_root}/pushtest/build/outputs/apk/debug/pushtest-debug.apk #{project_root}/site/#{apk_file}")
    git_commit(
      path: ["pushtest/build.gradle.kts", "site/"],
      message: "chore: release pushtest v1.0.#{new_version} [skip apk deploy]"
    )
  end

  desc "Deploy both apps to Firebase App Distribution"
  lane :deploy_all do
    # 1. Check git status is clean
    check_git_clean

    # 2. Setup git auth
    setup_git_auth

    # 3. Pull latest first
    sh("git pull --rebase origin main")

    # 4. Deploy VPCoffee (increment, build, Firebase, GitHub Pages, commit)
    deploy_vpcoffee

    # 5. Deploy PushTest (increment, build, Firebase, GitHub Pages, commit)
    deploy_pushtest

    # 6. Generate index.html with both APK links
    project_root = File.expand_path("..", __dir__)
    vp_version = sh("grep 'versionCode' #{project_root}/app/build.gradle.kts | grep -o '\\d*'").strip
    pt_version = sh("grep 'versionCode' #{project_root}/pushtest/build.gradle.kts | grep -o '\\d*'").strip
    vp_apk = sh("ls #{project_root}/site/VPCoffee-*.apk 2>/dev/null | head -1").strip
    pt_apk = sh("ls #{project_root}/site/PushTest-*.apk 2>/dev/null | head -1").strip
    sh("sed -e 's|__VP_APK__|#{File.basename(vp_apk)}|g' -e 's|__VP_VERSION__|1.0.#{vp_version}|g' -e 's|__PT_APK__|#{File.basename(pt_apk)}|g' #{project_root}/index.html > #{project_root}/site/index.html")
    sh("git add #{project_root}/site/index.html && git commit -m 'Update GitHub Pages index.html' || true")

    # 7. Push all commits
    sh("git push origin HEAD:main")

    # 8. Restore git remote
    restore_git_remote
  end
end
